{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 与 wrangler.jsonc 同一个 Worker，区别：public/ 内联进脚本（API Token 部署时 Static Assets 上传会 401）。
  // pnpm deploy:inline
  "name": "shortlink-personal",
  "account_id": "9151f72e404dd53f20b8e6667893237d",
  "main": "worker-inline/entry.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // 自定义域名（zone: rei8t.dev）
  "routes": [{ "pattern": "s.rei8t.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // 保留控制台里加的变量/secret
  "keep_vars": true,
  // 短码 -> 长链接。部署前先创建：npx wrangler kv namespace create shortlink-personal-KV，把 id 填进来
  "kv_namespaces": [{ "binding": "LINKS", "id": "4e73ff37c7184ad5ad35ba14cb36866e" }],
  // 访问统计：Workers Analytics Engine（数据集首次写入时自动创建）
  // Analytics Engine 需先在控制台启用（code 10089）；启用后取消注释
  // 社交预览「随机」：调 vector-wallpapers 的 OgImage 入口（那边部署好 OgImage 后取消注释）
  // "services": [{ "binding": "WALLPAPERS", "service": "vector-wallpapers", "entrypoint": "OgImage" }],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "shortlink_personal_clicks" }],
  "vars": {
    // 只有这些 Google 账号能进后台（逗号分隔）
    "ADMIN_EMAILS": "reiy.leoz@gmail.com",
    // 访问统计："on" | "off"
    "CLICK_STATS": "on",
    "ANALYTICS_DATASET": "shortlink_personal_clicks",
    // 统计查询用（Analytics Engine SQL API）
    "CF_ACCOUNT_ID": "9151f72e404dd53f20b8e6667893237d",
    // 自动生成短码的长度
    "CODE_LENGTH": "6"
  }
  // Secrets（不要提交；wrangler secret put … 或在 CF 控制台添加）：
  //   SESSION_SECRET（必填，随机长字符串）、GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET、
  //   CF_API_TOKEN（后台查看统计用，权限 Account → Account Analytics → Read）
  // Google Cloud 授权回调地址：https://s.rei8t.dev/auth/callback 与 http://localhost:8787/auth/callback
  // 可选 var OAUTH_REDIRECT_URI（默认 <origin>/auth/callback）。AUTH_DISABLED 仅供本地 .dev.vars 使用。
}
